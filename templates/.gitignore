# Place this file in the root of a Unity project.
# These defaults exclude generated output and project-specific content listed below.
# Add other exclusions only after reviewing what the project needs to keep.

# Unity-generated cache and local editor data
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Build output
/[Bb]uild/
/[Bb]uilds/

# Project-specific data and IDE settings excluded by default
/Thry/preset_cache.txt
/Thry/presets_known_materials.txt
/Thry/trash/
/.vscode/

# Keep only package manifests and lockfile in Packages/
/Packages/*
!/Packages/manifest.json
!/Packages/packages-lock.json
!/Packages/vpm-manifest.json

# Optional: ignore captures or recordings only if you do not need to keep them.
# /[Mm]emoryCaptures/
# /[Rr]ecordings/

# Unity-generated solution and project files at the repository root
/ExportedObj/
/.consulo/
/*.csproj
/*.unityproj
/*.sln
/*.slnx
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.opendb
/*.VC.db
/*.VC.VC.opendb

# Root IDE caches
/.vs/
/.gradle/

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
